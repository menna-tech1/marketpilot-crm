# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n --------------------------------------------------------------------
# WF-03 document ingestion
N8N_INGESTION_WEBHOOK_URL=
# WF-01 main orchestrator (AI chat)
ORCHESTRATOR_WEBHOOK_URL=
# Shared secret sent as the x-webhook-secret header in both directions
N8N_WEBHOOK_SECRET=

# --- Optional ---------------------------------------------------------------
# Public site URL used for auth redirects (Vercel sets VERCEL_URL automatically)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
